---
import Base from "./Base.astro";
import Container from "@components/Container.astro";
import BackToPrev from "@components/BackToPrev.astro";
import { formatDate, readingTime } from "@lib/utils";

interface Props {
  title: string;
  description?: string;
  date?: Date;
  readTime?: string;
}

const { title, description, date, readTime } = Astro.props;
---

<Base title={title} description={description}>
  <Container>
    <div class="animate py-5">
      <BackToPrev href="/notes">Back to notes</BackToPrev>
    </div>
    <article>
      <div class="animate space-y-1 py-2">
        <div class="flex items-center gap-1.5 text-sm text-stone-500 dark:text-stone-400">
          {date && <span>{formatDate(date)}</span>}
          {date && readTime && <span>·</span>}
          {readTime && <span>{readTime}</span>}
        </div>
        <h1 class="text-2xl font-semibold text-black dark:text-white">
          {title}
        </h1>
      </div>
      <div class="animate prose prose-stone dark:prose-invert max-w-none py-6">
        <slot />
      </div>
    </article>
  </Container>
</Base>