---
import Base from "./Base.astro";
import Container from "@components/Container.astro";
import BackToPrev from "@components/BackToPrev.astro";

interface Props {
  title: string;
  description?: string;
  backHref?: string;
  backLabel?: string;
}

const { title, description, backHref, backLabel } = Astro.props;
---

<Base title={title} description={description}>
  <Container>
    {backHref && (
      <div class="py-5">
        <BackToPrev href={backHref}>{backLabel}</BackToPrev>
      </div>
    )}
    <article class="max-w-measure pb-16">
      <header class="space-y-2 py-2">
        <h1 class="font-display text-2xl font-semibold tracking-tight text-ink">
          {title}
        </h1>
      </header>
      <div class="prose prose-neutral dark:prose-invert max-w-none py-6">
        <slot />
      </div>
    </article>
  </Container>
</Base>
