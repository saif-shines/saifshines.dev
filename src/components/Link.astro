---
import { cn } from "@lib/utils";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  href: string;
  external?: boolean;
}

const { href, external, class: className, ...rest } = Astro.props;

const isActive =
  href === Astro.url.pathname ||
  href === Astro.url.pathname.replace(/\/$/, "");
---

<a
  href={href}
  class={cn("underline-offset-2 transition-colors duration-short ease-hall",
    isActive
      ? "font-medium text-ink underline decoration-accent"
      : "text-ink-2 no-underline hover:text-ink hover:underline hover:decoration-rule",
    className
  )}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  {...rest}
>
  <slot />
</a>
