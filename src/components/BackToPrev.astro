---
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a
  href={href}
  class="pressable group inline-flex w-fit items-center gap-1.5 text-sm text-muted hover-ink"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="back-arrow"
    aria-hidden="true"
  >
    <line x1="19" y1="12" x2="5" y2="12"></line>
    <polyline points="12 19 5 12 12 5"></polyline>
  </svg>
  <slot />
</a>
