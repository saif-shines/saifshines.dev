---
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a
  href={href}
  class="group flex w-fit items-center gap-1.5 text-sm text-stone-500 transition-colors duration-300 ease-in-out hover:text-black dark:text-stone-400 dark:hover:text-white"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="transition-transform duration-300 ease-in-out group-hover:-translate-x-1"
  >
    <line x1="19" y1="12" x2="5" y2="12"></line>
    <polyline points="12 19 5 12 12 5"></polyline>
  </svg>
  <slot />
</a>