---
import Container from "@components/Container.astro";
import { SOCIALS } from "@consts";
---

<footer class="animate">
  <Container>
    <div class="flex items-center justify-between gap-y-2 py-6">
      <div class="text-sm text-stone-500 dark:text-stone-400">
        &copy; {new Date().getFullYear()} Saif Ali Shaik
      </div>
      <div class="flex flex-wrap items-center gap-4">
        {SOCIALS.map((social) => (
          <a
            href={social.HREF}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-stone-500 transition-colors duration-300 hover:text-black dark:text-stone-400 dark:hover:text-white"
          >
            {social.NAME}
          </a>
        ))}
        <button
          id="theme-toggle"
          aria-label="Toggle theme"
          class="size-7 rounded-full flex items-center justify-center text-stone-500 hover:text-black dark:text-stone-400 dark:hover:text-white transition-colors"
        >
          <svg id="sun-icon" class="hidden dark:block" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          <svg id="moon-icon" class="block dark:hidden" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
      </div>
    </div>
  </Container>
</footer>

<script>
  function init() {
    const toggle = document.getElementById("theme-toggle");
    toggle?.addEventListener("click", () => {
      const isDark = document.documentElement.classList.contains("dark");
      const next = isDark ? "light" : "dark";
      localStorage.setItem("theme", next);
      document.documentElement.classList.toggle("dark", next === "dark");
    });
  }
  document.addEventListener("DOMContentLoaded", init);
  document.addEventListener("astro:after-swap", init);
</script>