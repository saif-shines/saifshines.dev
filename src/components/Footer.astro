---
import Container from "@components/Container.astro";
import { SITE, SOCIALS } from "@consts";
---

<!-- Hallmark · footer: Ft6 letter close · design-system: design.md -->
<footer class="pb-12 pt-4">
  <Container>
    <hr class="page-rule mb-8" aria-hidden="true" />
    <div class="max-w-measure space-y-5">
      <p class="font-display text-lg leading-snug text-ink">
        Yours,<br />
        <span class="font-semibold">— {SITE.NAME}</span>
      </p>
      <p class="text-sm text-muted">
        P.S. Letters welcome at
        <a
          href={`mailto:${SITE.EMAIL}`}
          class="text-ink underline decoration-rule underline-offset-2 transition-[text-decoration-color] duration-short ease-hall hover:decoration-accent"
        >
          {SITE.EMAIL}
        </a>
        ·
        {SOCIALS.map((social, i) => (
          <>
            {i > 0 && " · "}
            <a
              href={social.HREF}
              target="_blank"
              rel="noopener noreferrer"
              class="text-ink underline decoration-rule underline-offset-2 transition-[text-decoration-color] duration-short ease-hall hover:decoration-accent"
            >
              {social.NAME}
            </a>
          </>
        ))}
      </p>
      <div class="flex flex-wrap items-center gap-4 pt-1">
        <span class="text-xs tabular-nums text-muted">
          © {new Date().getFullYear()}
        </span>
        <button
          id="theme-toggle"
          type="button"
          aria-label="Toggle theme"
          class="inline-flex size-8 items-center justify-center rounded-sm text-muted transition-colors duration-short ease-hall hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
        >
          <svg id="sun-icon" class="hidden dark:block" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          <svg id="moon-icon" class="block dark:hidden" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
      </div>
    </div>
  </Container>
</footer>

<script>
  function init() {
    const toggle = document.getElementById("theme-toggle");
    toggle?.addEventListener("click", () => {
      const isDark = document.documentElement.classList.contains("dark");
      const next = isDark ? "light" : "dark";
      localStorage.setItem("theme", next);
      document.documentElement.classList.toggle("dark", next ==="dark");
    });
  }
  document.addEventListener("DOMContentLoaded", init);
  document.addEventListener("astro:after-swap", init);
</script>
