---
import { formatDate } from "@lib/utils";

interface Props {
  title: string;
  description?: string;
  date?: Date;
  href: string;
}

const { title, description, date, href } = Astro.props;
---

<a href={href} class="group flex items-center gap-3 rounded-lg border border-black/15 p-4 transition-colors duration-300 ease-in-out hover:bg-black/5 dark:border-white/20 dark:hover:bg-white/5">
  <div class="flex-1 flex flex-col">
    <div class="font-semibold text-black dark:text-white group-hover:text-black dark:group-hover:text-white">
      {title}
    </div>
    {description && (
      <div class="text-sm text-stone-500 dark:text-stone-400 line-clamp-2">
        {description}
      </div>
    )}
    {date && (
      <div class="mt-1 text-xs text-stone-400 dark:text-stone-500">
        {formatDate(date)}
      </div>
    )}
  </div>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="text-stone-400 transition-transform duration-300 ease-in-out group-hover:translate-x-1 dark:text-stone-500"
  >
    <line x1="5" y1="12" x2="19" y2="12"></line>
    <polyline points="12 5 19 12 12 19"></polyline>
  </svg>
</a>