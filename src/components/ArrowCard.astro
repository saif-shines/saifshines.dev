---
import { formatDate } from "@lib/utils";

interface Props {
  title: string;
  description?: string;
  date?: Date;
  href: string;
}

const { title, description, date, href } = Astro.props;
---

<a
  href={href}
  class="group flex items-baseline justify-between gap-4 border-b border-rule py-3 transition-colors duration-short ease-hall last:border-b-0"
>
  <div class="min-w-0 flex-1">
    <div class="font-medium text-ink group-hover:underline group-hover:decoration-accent group-hover:underline-offset-2">
      {title}
    </div>
    {description && (
      <div class="mt-0.5 line-clamp-2 text-sm text-muted">
        {description}
      </div>
    )}
  </div>
  {date && (
    <time
      datetime={date.toISOString()}
      class="shrink-0 text-xs tabular-nums text-muted"
    >
      {formatDate(date)}
    </time>
  )}
</a>
