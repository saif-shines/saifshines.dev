---
import Base from "@layouts/Base.astro";
import Container from "@components/Container.astro";
import EcosystemList from "@components/EcosystemList.astro";
import { getCollection } from "astro:content";
import { ECOSYSTEM_LISTINGS } from "@consts";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);

const contributions = (await getCollection("contributions")).sort(
  (a, b) => (b.data.prs ?? 0) - (a.data.prs ?? 0)
);
---

<Base title="Projects" description="Open source projects and contributions.">
  <Container>
    <aside class="max-w-measure space-y-2 py-10">
      <h1 class="font-display text-2xl font-semibold tracking-tight text-ink">Projects</h1>
      <p class="leading-relaxed text-ink-2">
        Things I've built and open source work I contribute to.
      </p>
    </aside>

    <section class="space-y-3 pb-10">
      <ul class="not-prose divide-y divide-rule">
        {projects.map((project) => (
          <li>
            <a
              href={project.data.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4"
            >
              <div class="flex min-w-0 flex-wrap items-baseline gap-x-2 gap-y-1">
                <span class="font-medium text-ink group-hover:underline group-hover:decoration-accent group-hover:underline-offset-2">
                  {project.data.name}
                </span>
                {project.data.language && (
                  <span class="text-[10px] font-medium uppercase tracking-wider text-muted">
                    {project.data.language}
                  </span>
                )}
                {project.data.status && (
                  <span class="status-chip">{project.data.status}</span>
                )}
              </div>
              <p class="line-clamp-2 text-xs text-muted sm:max-w-xs sm:text-right">
                {project.data.description}
              </p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <hr class="page-rule" aria-hidden="true" />

    <section class="space-y-4 py-10">
      <h2 class="font-display text-lg font-semibold text-ink">Open source contributions</h2>
      <ul class="not-prose divide-y divide-rule">
        {contributions.map((c) => (
          <li>
            <a
              href={c.data.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-start gap-3 py-3"
            >
              <div class="min-w-0 flex-1">
                <div class="font-medium text-ink group-hover:underline group-hover:decoration-accent group-hover:underline-offset-2">
                  {c.data.repo}
                </div>
                <div class="mt-0.5 text-xs text-muted">
                  {c.data.description}
                </div>
              </div>
              {c.data.prs && (
                <span class="mt-0.5 shrink-0 text-xs tabular-nums text-muted">
                  {c.data.prs} {c.data.prs === 1 ? "PR" : "PRs"}
                </span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <hr class="page-rule" aria-hidden="true" />

    <section class="space-y-4 py-10">
      <h2 class="font-display text-lg font-semibold text-ink">Ecosystem listings</h2>
      <EcosystemList items={ECOSYSTEM_LISTINGS} />
    </section>
  </Container>
</Base>
