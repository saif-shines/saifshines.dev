---
import Base from "@layouts/Base.astro";
import Container from "@components/Container.astro";
---

<Base title="Resume" description="Saif Ali Shaik — Founding Developer Advocate">
  <Container>
    <div class="animate py-10 space-y-10">

      <!-- Header -->
      <header class="space-y-2">
        <h1 class="text-2xl font-semibold text-black dark:text-white">Saif Ali Shaik</h1>
        <p class="text-stone-600 dark:text-stone-400 leading-relaxed max-w-lg">
          Two time founding developer advocate and developer tools builder with 7+ years of experience
          shipping CLIs, plugins, API workflows, documentation systems, and automation for developers.
        </p>
        <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-stone-500 dark:text-stone-400">
          <a href="mailto:saif.shines@hey.com" class="hover:text-black dark:hover:text-white transition-colors">saif.shines@hey.com</a>
          <a href="https://linkedin.com/in/saif-shines" target="_blank" rel="noopener noreferrer" class="hover:text-black dark:hover:text-white transition-colors">linkedin.com/in/saif-shines</a>
          <a href="https://world.hey.com/saif.shines" target="_blank" rel="noopener noreferrer" class="hover:text-black dark:hover:text-white transition-colors">world.hey.com/saif.shines</a>
        </div>
      </header>

      <!-- Experience -->
      <section class="space-y-8">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-stone-400 dark:text-stone-500">Experience</h2>

        <div class="space-y-2">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-semibold text-black dark:text-white">Founding Developer Advocate</h3>
            <span class="text-sm text-stone-500 dark:text-stone-400">Jul 2024 – Present</span>
          </div>
          <div class="text-sm text-stone-500 dark:text-stone-400">Scalekit · Bengaluru</div>
          <ul class="list-disc pl-5 text-sm text-stone-700 dark:text-stone-300 space-y-1.5 mt-2">
            <li><strong class="text-black dark:text-white">Primary owner of <a href="https://docs.scalekit.com" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 decoration-stone-300 dark:decoration-stone-600">docs.scalekit.com</a></strong> end-to-end — auth, infrastructure, content, and deployment cycles. Built on <strong class="text-black dark:text-white">Astro Starlight + Netlify</strong>.</li>
            <li>Stay in sync with product managers to ensure docs reflect the most up-to-date features. <strong class="text-black dark:text-white">Observe, measure, and act through PostHog analytics.</strong></li>
            <li>Act as a <strong class="text-black dark:text-white">consultant to engineering</strong> on taxonomy, terminology, and API interfaces including request/response structure design.</li>
            <li>Consultant to marketing — bridge semi-technical activities such as <strong class="text-black dark:text-white">building pages, devising illustrations</strong>, listing Scalekit on repositories, and authoring content for inbound and bottom-up efforts.</li>
            <li>Build and maintain developer tools: <strong class="text-black dark:text-white">CLI tools and AI agent plugins</strong> (Scalekit marketplace plugin for Claude Code, GitHub Copilot, and Cursor).</li>
            <li>Authored the <strong class="text-black dark:text-white"><a href="https://github.com/scalekit-inc/cli" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 decoration-stone-300 dark:decoration-stone-600">Scalekit CLI</a></strong> and thoughtfully authored tools for the <strong class="text-black dark:text-white">Scalekit MCP Server</strong> — paying attention to developer journey rather than simply wrapping the OpenAPI spec.</li>
            <li>Build ecosystem presence with open-source repos and 3rd-party integrations, e.g. <strong class="text-black dark:text-white"><a href="https://docs.astro.build/en/guides/backend/scalekit/" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 decoration-stone-300 dark:decoration-stone-600">Scalekit on Astro Docs</a></strong>.</li>
          </ul>
        </div>

        <div class="space-y-2">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-semibold text-black dark:text-white">Senior Developer Advocate</h3>
            <span class="text-sm text-stone-500 dark:text-stone-400">Apr 2023 – Jul 2024</span>
          </div>
          <div class="text-sm text-stone-500 dark:text-stone-400">Freshworks · Bengaluru</div>
          <ul class="list-disc pl-5 text-sm text-stone-700 dark:text-stone-300 space-y-1.5 mt-2">
            <li>Architected a <strong class="text-black dark:text-white">modular approach for Global Apps</strong>, enabling developers to author code once and deploy across multiple Freshworks ecosystem products.</li>
            <li>Designed and implemented <strong class="text-black dark:text-white">modular code interfaces in JavaScript</strong> to enable developers to test locally and deploy seamlessly to production.</li>
            <li>Coordinated with technical writing, engineering, design, and marketing to <strong class="text-black dark:text-white">unify developer documentation</strong> and streamline platform UX on developers.freshworks.com.</li>
            <li>Published technical insights and practical examples through blog posts, <strong class="text-black dark:text-white">driving adoption of genAI libraries</strong> in JavaScript projects.</li>
          </ul>
        </div>

        <div class="space-y-2">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-semibold text-black dark:text-white">Senior Developer Advocate</h3>
            <span class="text-sm text-stone-500 dark:text-stone-400">Apr 2021 – Apr 2023</span>
          </div>
          <div class="text-sm text-stone-500 dark:text-stone-400">Freshworks · Bengaluru</div>
          <ul class="list-disc pl-5 text-sm text-stone-700 dark:text-stone-300 space-y-1.5 mt-2">
            <li>Designed and launched a <strong class="text-black dark:text-white">new serverless event</strong> for Freshworks Developers, simplifying app lifecycle management based on insights from <strong class="text-black dark:text-white">8 user research interviews</strong>.</li>
            <li>Upgraded Freshworks SDK with new UX features to CLI, ensuring <strong class="text-black dark:text-white">90%+ code coverage</strong>. Released to the community via Jenkins CI as <strong class="text-black dark:text-white">v8.0</strong>.</li>
            <li>Built integrations between <strong class="text-black dark:text-white">Orbit, Discourse, Calendly</strong>, and internal ticketing systems to measure developer engagement and monthly active developers.</li>
            <li><strong class="text-black dark:text-white">Hired and mentored 3 new advocates</strong>. Set up an internal advocacy program with a translation layer to product and engineering teams.</li>
            <li>Devised <strong class="text-black dark:text-white">self-serve certification programs</strong>, certifying <strong class="text-black dark:text-white">40 developers in 6 weeks</strong>. Reduced <strong class="text-black dark:text-white">35 support tickets monthly</strong> by automating ticket routing across 3 business units.</li>
          </ul>
        </div>

        <div class="space-y-2">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-semibold text-black dark:text-white">Founding Developer Advocate</h3>
            <span class="text-sm text-stone-500 dark:text-stone-400">Jan 2019 – Apr 2021</span>
          </div>
          <div class="text-sm text-stone-500 dark:text-stone-400">Freshworks · Chennai</div>
          <ul class="list-disc pl-5 text-sm text-stone-700 dark:text-stone-300 space-y-1.5 mt-2">
            <li>Established community.freshworks.dev, <strong class="text-black dark:text-white">growing organically to 3,500+ developers</strong> in 3 years.</li>
            <li>Attracted attention to Freshworks' OSS story via Hacktoberfest — <strong class="text-black dark:text-white">25 contributors in 2019, 64 in 2020, 43 PRs closed</strong>.</li>
            <li><strong class="text-black dark:text-white">Reimagined sample app discovery</strong>, revising 35+ apps. Authored <strong class="text-black dark:text-white">18 tutorials</strong> and <strong class="text-black dark:text-white">10 Wiki articles</strong> to scale 1-to-many enablement.</li>
            <li>Dedicated <strong class="text-black dark:text-white">60 minutes daily</strong> to the community, closing <strong class="text-black dark:text-white">35+ topics monthly</strong>. Migrated top 15 apps from Freshsales Classic to Suite with critical migration guides.</li>
            <li>Conducted internal <strong class="text-black dark:text-white">hackathons (Appathons)</strong> engaging <strong class="text-black dark:text-white">45+ teams</strong> each time to build and publish apps to Freshworks Marketplace.</li>
          </ul>
        </div>

        <div class="space-y-2">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-semibold text-black dark:text-white">Student Experience Intern</h3>
            <span class="text-sm text-stone-500 dark:text-stone-400">Sep 2018 – Dec 2018</span>
          </div>
          <div class="text-sm text-stone-500 dark:text-stone-400">Udacity · New Delhi</div>
          <ul class="list-disc pl-5 text-sm text-stone-700 dark:text-stone-300 space-y-1.5 mt-2">
            <li>Led the <strong class="text-black dark:text-white">Google India Scholars Community</strong> for 1,000+ students, achieving a <strong class="text-black dark:text-white">50% graduation rate</strong> through scalable event strategies and data metrics.</li>
            <li>Championed a <strong class="text-black dark:text-white">scalable mentorship initiative</strong>, pairing students with industry professionals.</li>
          </ul>
        </div>
      </section>

      <!-- Involvement -->
      <section class="space-y-8">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-stone-400 dark:text-stone-500">Involvement</h2>

        <div class="space-y-2">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-semibold text-black dark:text-white">Creator of Hacksmith CLI</h3>
            <span class="text-sm text-stone-500 dark:text-stone-400">Sep 2025 – Nov 2025</span>
          </div>
          <div class="text-sm text-stone-500 dark:text-stone-400">Scalekit</div>
          <ul class="list-disc pl-5 text-sm text-stone-700 dark:text-stone-300 space-y-1.5 mt-2">
            <li>Accelerated engineering productivity by automating complex setup and integration tasks through guided workflows called <strong class="text-black dark:text-white">blueprints</strong>.</li>
            <li>Evolved the blueprint concept into <strong class="text-black dark:text-white">plugins for Claude Code, Cursor, and Copilot CLIs</strong>.</li>
            <li>Published as open-source on npm. <strong class="text-black dark:text-white">Won 3rd place at the You.com Agentic Hackathon 2025</strong>.</li>
          </ul>
        </div>

        <div class="space-y-2">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-semibold text-black dark:text-white">Lead, Google Developer Student Clubs</h3>
            <span class="text-sm text-stone-500 dark:text-stone-400">Aug 2017 – Dec 2018</span>
          </div>
          <div class="text-sm text-stone-500 dark:text-stone-400">Sathyabama University · Chennai</div>
          <ul class="list-disc pl-5 text-sm text-stone-700 dark:text-stone-300 space-y-1.5 mt-2">
            <li>Trained <strong class="text-black dark:text-white">550+ students</strong> in Android Studio through hands-on workshops.</li>
            <li>Enabled the college to be <strong class="text-black dark:text-white">selected as one of 185 clubs from 2,000+</strong> student clubs across India.</li>
          </ul>
        </div>

        <div class="space-y-2">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-semibold text-black dark:text-white">Student Partner</h3>
            <span class="text-sm text-stone-500 dark:text-stone-400">Aug 2017 – Dec 2018</span>
          </div>
          <div class="text-sm text-stone-500 dark:text-stone-400">Microsoft</div>
          <ul class="list-disc pl-5 text-sm text-stone-700 dark:text-stone-300 space-y-1.5 mt-2">
            <li>Developed session materials and coordinated <strong class="text-black dark:text-white">campus workshops</strong> focused on emerging software platforms.</li>
          </ul>
        </div>

        <div class="space-y-2">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-semibold text-black dark:text-white">Dell Campassador</h3>
            <span class="text-sm text-stone-500 dark:text-stone-400">Oct 2017 – Jun 2018</span>
          </div>
          <div class="text-sm text-stone-500 dark:text-stone-400">Dell</div>
          <ul class="list-disc pl-5 text-sm text-stone-700 dark:text-stone-300 space-y-1.5 mt-2">
            <li>Ranked <strong class="text-black dark:text-white">All India Top #4</strong> across all competing colleges in the Dell Campus Ambassador program.</li>
          </ul>
        </div>
      </section>

      <!-- Education -->
      <section class="space-y-4">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-stone-400 dark:text-stone-500">Education</h2>
        <div>
          <h3 class="font-semibold text-black dark:text-white">Bachelor of Engineering: Computer Science</h3>
          <div class="text-sm text-stone-500 dark:text-stone-400">Sathyabama Institute of Science & Technology, Chennai · 2015 – 2019 · Grade: 85%</div>
        </div>
      </section>

      <!-- Accomplishments -->
      <section class="space-y-4">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-stone-400 dark:text-stone-500">Accomplishments</h2>
        <ul class="list-disc pl-5 text-sm text-stone-700 dark:text-stone-300 space-y-1.5">
          <li><strong class="text-black dark:text-white">Distinguished Alumni Awardee</strong> (2023), Sathyabama University</li>
          <li><strong class="text-black dark:text-white">Certificate of Achievement</strong> for Outstanding Team Collaboration & Agility through accountability with ownership, Freshworks</li>
          <li><strong class="text-black dark:text-white">Star of Excellence Awardee</strong> (2015–2019), Sathyabama University</li>
          <li>Dell Campus Ambassador Program — <strong class="text-black dark:text-white">All India Rank #4</strong></li>
        </ul>
      </section>

      <!-- Skills -->
      <section class="space-y-4">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-stone-400 dark:text-stone-500">Skills</h2>
        <div class="flex flex-wrap gap-2">
          {["JavaScript", "Node.js", "TypeScript", "Python", "Building CLIs", "Astro", "Auth & SSO", "API Documentation", "Claude Code Plugins", "Developer Tools", "Git", "Bun", "Yarn", "PostHog"].map((skill) => (
            <span class="text-sm rounded-full bg-black/5 dark:bg-white/10 px-3 py-1 text-stone-700 dark:text-stone-300">{skill}</span>
          ))}
        </div>
      </section>

    </div>
  </Container>
</Base>

<style>
  @media print {
    header, footer, nav { display: none !important; }
    .animate { opacity: 1 !important; transform: none !important; animation: none !important; }
  }
</style>