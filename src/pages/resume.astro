---
import Base from "@layouts/Base.astro";
import Container from "@components/Container.astro";
import {
  ROLE,
  ROLE_FOCUS,
  ROLE_WRITING,
  ROLE_WRITING_ORG,
  ROLE_WRITING_URL,
  ROLE_WRITING_NOTE,
  ROLE_WRITING_LOGO,
} from "@consts";
---

<Base title="Resume" description={`Saif Ali Shaik, ${ROLE}`}>
  <Container>
    <div class="py-10 space-y-10">

      <!-- Header -->
      <header class="space-y-2">
        <h1 class="font-display text-2xl font-semibold tracking-tight text-ink">Saif Ali Shaik</h1>
        <p class="text-sm font-medium text-ink-2">{ROLE}</p>
        <p class="text-sm text-muted">{ROLE_FOCUS}</p>
        <p class="flex flex-wrap items-center gap-2 text-sm text-ink-2">
          <img
            src={ROLE_WRITING_LOGO}
            alt=""
            width="18"
            height="18"
            class="size-[18px] shrink-0 dark:invert"
          />
          <span>
            <span class="font-medium text-ink">{ROLE_WRITING}</span>
            {" "}for{" "}
            <a
              href={ROLE_WRITING_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="font-medium text-ink underline decoration-rule underline-offset-2 hover:decoration-accent"
            >{ROLE_WRITING_ORG}.org</a>
            <span class="text-muted"> · {ROLE_WRITING_NOTE}</span>
          </span>
        </p>
        <p class="text-ink-2 leading-relaxed max-w-lg">
          Two-time founding developer advocate and developer tools builder with 7+ years of experience
          shipping CLIs, plugins, API workflows, documentation systems, and automation for developers.
        </p>
        <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-muted">
          <a href="mailto:saif.shines@hey.com" class="hover:text-ink transition-colors">saif.shines@hey.com</a>
          <a href="https://linkedin.com/in/saif-shines" target="_blank" rel="noopener noreferrer" class="hover:text-ink transition-colors">linkedin.com/in/saif-shines</a>
          <a href="https://world.hey.com/saif.shines" target="_blank" rel="noopener noreferrer" class="hover:text-ink transition-colors">world.hey.com/saif.shines</a>
        </div>
      </header>

      <!-- Experience -->
      <section class="space-y-8">
        <h2 class="font-display text-lg font-semibold text-ink">Experience</h2>

        <div class="space-y-2">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-semibold text-ink">Founding Developer Advocate</h3>
            <span class="text-sm text-muted">Jul 2024 – Present</span>
          </div>
          <div class="text-sm text-muted">Scalekit · Bengaluru</div>
          <ul class="list-disc pl-5 text-sm text-ink-2 space-y-1.5 mt-2">
            <li><strong class="text-ink">Primary owner of <a href="https://docs.scalekit.com" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 decoration-rule">docs.scalekit.com</a></strong> end-to-end (Astro Starlight + Netlify), including continuous polish on <strong class="text-ink">quickstarts, UX copy, and onboarding journeys</strong>.</li>
            <li><strong class="text-ink">Context engineering for a DX flywheel:</strong> Claude routines mine customer support (docs-signal) and product repos (product-signal), then open developer-docs issues and PRs—e.g. <a href="https://github.com/scalekit-inc/developer-docs/pull/755" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 decoration-rule">support-driven PR #755</a> and <a href="https://github.com/scalekit-inc/developer-docs/pull/902" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 decoration-rule">product-signal PR #902</a>.</li>
            <li>Maintain an <strong class="text-ink">internal skillkit marketplace</strong> for shared engineers (Claude plugin format + DX harness), alongside public agent skills for Claude Code, Cursor, and Copilot (<a href="https://github.com/Saif-Shines/skills" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 decoration-rule">github.com/Saif-Shines/skills</a>).</li>
            <li>Stay in sync with product managers so docs track shipping features. <strong class="text-ink">Observe, measure, and act through PostHog analytics.</strong></li>
            <li>Act as a <strong class="text-ink">consultant to engineering</strong> on taxonomy, terminology, and API interfaces including request/response structure design.</li>
            <li>Build and maintain developer tools: <strong class="text-ink"><a href="https://github.com/scalekit-inc/cli" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 decoration-rule">Scalekit CLI</a></strong>, MCP server tooling, and AI agent plugins—focused on the developer journey, not only OpenAPI wrappers.</li>
            <li>Build ecosystem presence with 3rd-party integrations and listings across <strong class="text-ink">Astro</strong>, <strong class="text-ink">xmcp</strong>, <strong class="text-ink">LiteLLM</strong>, <strong class="text-ink">FastMCP</strong>, <strong class="text-ink">FastRouter</strong>, <strong class="text-ink">Apify</strong>, <strong class="text-ink">Chargebee</strong>, Cursor Directory, and voice agents (LiveKit, Vapi). <a href="/projects" class="underline underline-offset-2 decoration-rule">See full list</a>.</li>
          </ul>
        </div>

        <!-- Free-time writing role (current, parallel to full-time work) -->
        <div class="space-y-2">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="flex items-center gap-2 font-semibold text-ink">
              <img
                src={ROLE_WRITING_LOGO}
                alt=""
                width="20"
                height="20"
                class="size-5 shrink-0 dark:invert"
              />
              {ROLE_WRITING}
            </h3>
            <span class="text-sm text-muted">Present · free time</span>
          </div>
          <div class="text-sm text-muted">
            <a
              href={ROLE_WRITING_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="underline decoration-rule underline-offset-2 hover:decoration-accent"
            >{ROLE_WRITING_ORG}.org</a>
            · volunteer publication writing
          </div>
          <ul class="list-disc pl-5 text-sm text-ink-2 space-y-1.5 mt-2">
            <li>
              Recently joined as an <strong class="text-ink">author for freeCodeCamp.org</strong>, writing technical tutorials and developer education in free time—separate from full-time DevRel work.
            </li>
            <li>
              First freeCodeCamp pieces are in progress; the public author page will replace the publication home link once articles ship. Other public writing includes JavaScript in Plain English.
            </li>
          </ul>
        </div>

        <div class="space-y-2">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-semibold text-ink">Senior Developer Advocate</h3>
            <span class="text-sm text-muted">Apr 2023 – Jul 2024</span>
          </div>
          <div class="text-sm text-muted">Freshworks · Bengaluru</div>
          <ul class="list-disc pl-5 text-sm text-ink-2 space-y-1.5 mt-2">
            <li>Architected a <strong class="text-ink">modular approach for Global Apps</strong>, enabling developers to author code once and deploy across multiple Freshworks ecosystem products.</li>
            <li>Designed and implemented <strong class="text-ink">modular code interfaces in JavaScript</strong> to enable developers to test locally and deploy seamlessly to production.</li>
            <li>Coordinated with technical writing, engineering, design, and marketing to <strong class="text-ink">unify developer documentation</strong> and streamline platform UX on developers.freshworks.com.</li>
            <li>Published technical insights and practical examples through blog posts, <strong class="text-ink">driving adoption of genAI libraries</strong> in JavaScript projects.</li>
          </ul>
        </div>

        <div class="space-y-2">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-semibold text-ink">Senior Developer Advocate</h3>
            <span class="text-sm text-muted">Apr 2021 – Apr 2023</span>
          </div>
          <div class="text-sm text-muted">Freshworks · Bengaluru</div>
          <ul class="list-disc pl-5 text-sm text-ink-2 space-y-1.5 mt-2">
            <li>Designed and launched a <strong class="text-ink">new serverless event</strong> for Freshworks Developers, simplifying app lifecycle management based on insights from <strong class="text-ink">8 user research interviews</strong>.</li>
            <li>Upgraded Freshworks SDK with new UX features to CLI, ensuring <strong class="text-ink">90%+ code coverage</strong>. Released to the community via Jenkins CI as <strong class="text-ink">v8.0</strong>.</li>
            <li>Built integrations between <strong class="text-ink">Orbit, Discourse, Calendly</strong>, and internal ticketing systems to measure developer engagement and monthly active developers.</li>
            <li><strong class="text-ink">Hired and mentored 3 new advocates</strong>. Set up an internal advocacy program with a translation layer to product and engineering teams.</li>
            <li>Devised <strong class="text-ink">self-serve certification programs</strong>, certifying <strong class="text-ink">40 developers in 6 weeks</strong>. Reduced <strong class="text-ink">35 support tickets monthly</strong> by automating ticket routing across 3 business units.</li>
          </ul>
        </div>

        <div class="space-y-2">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-semibold text-ink">Founding Developer Advocate</h3>
            <span class="text-sm text-muted">Jan 2019 – Apr 2021</span>
          </div>
          <div class="text-sm text-muted">Freshworks · Chennai</div>
          <ul class="list-disc pl-5 text-sm text-ink-2 space-y-1.5 mt-2">
            <li>Established community.freshworks.dev, <strong class="text-ink">growing organically to 3,500+ developers</strong> in 3 years.</li>
            <li>Attracted attention to Freshworks' OSS story via Hacktoberfest: <strong class="text-ink">25 contributors in 2019, 64 in 2020, 43 PRs closed</strong>.</li>
            <li><strong class="text-ink">Reimagined sample app discovery</strong>, revising 35+ apps. Authored <strong class="text-ink">18 tutorials</strong> and <strong class="text-ink">10 Wiki articles</strong> to scale 1-to-many enablement.</li>
            <li>Dedicated <strong class="text-ink">60 minutes daily</strong> to the community, closing <strong class="text-ink">35+ topics monthly</strong>. Migrated top 15 apps from Freshsales Classic to Suite with critical migration guides.</li>
            <li>Conducted internal <strong class="text-ink">hackathons (Appathons)</strong> engaging <strong class="text-ink">45+ teams</strong> each time to build and publish apps to Freshworks Marketplace.</li>
          </ul>
        </div>

        <div class="space-y-2">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-semibold text-ink">Student Experience Intern</h3>
            <span class="text-sm text-muted">Sep 2018 – Dec 2018</span>
          </div>
          <div class="text-sm text-muted">Udacity · New Delhi</div>
          <ul class="list-disc pl-5 text-sm text-ink-2 space-y-1.5 mt-2">
            <li>Led the <strong class="text-ink">Google India Scholars Community</strong> for 1,000+ students, achieving a <strong class="text-ink">50% graduation rate</strong> through scalable event strategies and data metrics.</li>
            <li>Championed a <strong class="text-ink">scalable mentorship initiative</strong>, pairing students with industry professionals.</li>
          </ul>
        </div>
      </section>

      <!-- Involvement -->
      <section class="space-y-8">
        <h2 class="font-display text-lg font-semibold text-ink">Involvement</h2>

        <div class="space-y-2">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-semibold text-ink">Creator of Hacksmith CLI</h3>
            <span class="text-sm text-muted">Sep 2025 – Nov 2025</span>
          </div>
          <div class="text-sm text-muted">Scalekit</div>
          <ul class="list-disc pl-5 text-sm text-ink-2 space-y-1.5 mt-2">
            <li>Accelerated engineering productivity by automating complex setup and integration tasks through guided workflows called <strong class="text-ink">blueprints</strong>.</li>
            <li>Evolved the blueprint concept into <strong class="text-ink">plugins for Claude Code, Cursor, and Copilot CLIs</strong>.</li>
            <li>Published as open-source on npm. <strong class="text-ink">Won 3rd place at the You.com Agentic Hackathon 2025</strong>.</li>
          </ul>
        </div>

        <div class="space-y-2">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-semibold text-ink">Lead, Google Developer Student Clubs</h3>
            <span class="text-sm text-muted">Aug 2017 – Dec 2018</span>
          </div>
          <div class="text-sm text-muted">Sathyabama University · Chennai</div>
          <ul class="list-disc pl-5 text-sm text-ink-2 space-y-1.5 mt-2">
            <li>Trained <strong class="text-ink">550+ students</strong> in Android Studio through hands-on workshops.</li>
            <li>Enabled the college to be <strong class="text-ink">selected as one of 185 clubs from 2,000+</strong> student clubs across India.</li>
          </ul>
        </div>

        <div class="space-y-2">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-semibold text-ink">Student Partner</h3>
            <span class="text-sm text-muted">Aug 2017 – Dec 2018</span>
          </div>
          <div class="text-sm text-muted">Microsoft</div>
          <ul class="list-disc pl-5 text-sm text-ink-2 space-y-1.5 mt-2">
            <li>Developed session materials and coordinated <strong class="text-ink">campus workshops</strong> focused on emerging software platforms.</li>
          </ul>
        </div>

        <div class="space-y-2">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-semibold text-ink">Dell Campassador</h3>
            <span class="text-sm text-muted">Oct 2017 – Jun 2018</span>
          </div>
          <div class="text-sm text-muted">Dell</div>
          <ul class="list-disc pl-5 text-sm text-ink-2 space-y-1.5 mt-2">
            <li>Ranked <strong class="text-ink">All India Top #4</strong> across all competing colleges in the Dell Campus Ambassador program.</li>
          </ul>
        </div>
      </section>

      <!-- Education -->
      <section class="space-y-4">
        <h2 class="font-display text-lg font-semibold text-ink">Education</h2>
        <div>
          <h3 class="font-semibold text-ink">Bachelor of Engineering: Computer Science</h3>
          <div class="text-sm text-muted">Sathyabama Institute of Science & Technology, Chennai · 2015 – 2019 · Grade: 85%</div>
        </div>
      </section>

      <!-- Accomplishments -->
      <section class="space-y-4">
        <h2 class="font-display text-lg font-semibold text-ink">Accomplishments</h2>
        <ul class="list-disc pl-5 text-sm text-ink-2 space-y-1.5">
          <li><strong class="text-ink">Distinguished Alumni Awardee</strong> (2023), Sathyabama University</li>
          <li><strong class="text-ink">Certificate of Achievement</strong> for Outstanding Team Collaboration & Agility through accountability with ownership, Freshworks</li>
          <li><strong class="text-ink">Star of Excellence Awardee</strong> (2015–2019), Sathyabama University</li>
          <li>Dell Campus Ambassador Program, <strong class="text-ink">All India Rank #4</strong></li>
        </ul>
      </section>

      <!-- Skills -->
      <section class="space-y-4">
        <h2 class="font-display text-lg font-semibold text-ink">Skills</h2>
        <div class="flex flex-wrap gap-2">
          {["JavaScript", "Node.js", "TypeScript", "Python", "Building CLIs", "Astro", "Auth & SSO", "API Documentation", "Claude Code Plugins", "Developer Tools", "Git", "Bun", "Yarn", "PostHog"].map((skill) => (
            <span class="text-sm rounded-full bg-chip px-3 py-1 text-ink-2">{skill}</span>
          ))}
        </div>
      </section>

    </div>
  </Container>
</Base>

<style>
  @media print {
    header, footer, nav { display: none !important; }
    .animate { opacity: 1 !important; transform: none !important; animation: none !important; }
  }
</style>