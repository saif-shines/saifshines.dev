---
import Base from "@layouts/Base.astro";
import Container from "@components/Container.astro";
---

<Base title="Resume" description="Saif Ali Shaik — Founding Developer Advocate">
  <Container>
    <div class="animate py-10 space-y-10">

      <!-- Header -->
      <header class="space-y-2">
        <h1 class="text-2xl font-semibold text-black dark:text-white">Saif Ali Shaik</h1>
        <p class="text-stone-600 dark:text-stone-400 leading-relaxed max-w-lg">
          Two time founding developer advocate and developer tools builder with 7+ years of experience
          shipping CLIs, plugins, API workflows, documentation systems, and automation for developers.
        </p>
        <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-stone-500 dark:text-stone-400">
          <a href="mailto:saif.shines@hey.com" class="hover:text-black dark:hover:text-white transition-colors">saif.shines@hey.com</a>
          <a href="https://linkedin.com/in/saif-shines" target="_blank" rel="noopener noreferrer" class="hover:text-black dark:hover:text-white transition-colors">linkedin.com/in/saif-shines</a>
          <a href="https://world.hey.com/saif.shines" target="_blank" rel="noopener noreferrer" class="hover:text-black dark:hover:text-white transition-colors">world.hey.com/saif.shines</a>
        </div>
      </header>

      <!-- Experience -->
      <section class="space-y-8">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-stone-400 dark:text-stone-500">Experience</h2>

        <div class="space-y-2">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-semibold text-black dark:text-white">Founding Developer Advocate</h3>
            <span class="text-sm text-stone-500 dark:text-stone-400">Jul 2024 – Present</span>
          </div>
          <div class="text-sm text-stone-500 dark:text-stone-400">Scalekit · Bengaluru</div>
          <ul class="text-sm text-stone-700 dark:text-stone-300 space-y-1.5 mt-2">
            <li>Owned docs.scalekit.com end-to-end across architecture, content, deployment, and developer workflow design, covering authentication, infrastructure, and implementation journeys.</li>
            <li>Built and maintained developer tools including CLI workflows and AI agent plugins for Claude Code, GitHub Copilot, and Cursor to simplify authentication integration.</li>
            <li>Worked closely with engineering on API taxonomy, terminology, and request/response design to improve implementation clarity and developer usability.</li>
            <li>Managed the docs platform using Astro Starlight, Netlify, and PostHog, using analytics and developer behavior to improve information architecture and product onboarding.</li>
          </ul>
        </div>

        <div class="space-y-2">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-semibold text-black dark:text-white">Senior Developer Advocate</h3>
            <span class="text-sm text-stone-500 dark:text-stone-400">Apr 2023 – Jul 2024</span>
          </div>
          <div class="text-sm text-stone-500 dark:text-stone-400">Freshworks · Bengaluru</div>
          <ul class="text-sm text-stone-700 dark:text-stone-300 space-y-1.5 mt-2">
            <li>Architected a modular approach for Global Apps, enabling developers to author code once and deploy across multiple Freshworks ecosystem products.</li>
            <li>Designed and implemented modular code interfaces in JavaScript to enable developers to test applications locally and deploy seamlessly to production.</li>
            <li>Coordinated with technical writing, engineering, design, and marketing teams to unify developer documentation and streamline platform user experience on developers.freshworks.com.</li>
            <li>Published technical insights and practical examples through blog posts and repository documentation, driving adoption of genAI libraries in JavaScript projects.</li>
          </ul>
        </div>

        <div class="space-y-2">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-semibold text-black dark:text-white">Senior Developer Advocate</h3>
            <span class="text-sm text-stone-500 dark:text-stone-400">Apr 2021 – Apr 2023</span>
          </div>
          <div class="text-sm text-stone-500 dark:text-stone-400">Freshworks · Bengaluru</div>
          <ul class="text-sm text-stone-700 dark:text-stone-300 space-y-1.5 mt-2">
            <li>Designed and launched a new serverless event for Freshworks Developers, simplifying app lifecycle management based on insights from 8 user research interviews.</li>
            <li>Proposed more than 80 user stories to product development teams to identify and address developer pain points.</li>
            <li>Drove a metrics-driven culture by aligning success metrics for Developer Relations with company OKRs, adopting tools like Orbit to measure developer engagement.</li>
            <li>Devised and launched an enablement journey for Freshworks partners — foundations, seasoned, and enterprise-level certifications.</li>
            <li>Released to the community via Jenkins CI as v8.0. Built integrations between Orbit, Discourse, Calendly and internal ticketing systems.</li>
          </ul>
        </div>

        <div class="space-y-2">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-semibold text-black dark:text-white">Founding Developer Advocate</h3>
            <span class="text-sm text-stone-500 dark:text-stone-400">Jan 2019 – Apr 2021</span>
          </div>
          <div class="text-sm text-stone-500 dark:text-stone-400">Freshworks · Chennai</div>
          <ul class="text-sm text-stone-700 dark:text-stone-300 space-y-1.5 mt-2">
            <li>Established a community of Freshworks Developers at community.freshworks.dev, growing organically to more than 3500+ developers in 3 years.</li>
            <li>Built an automation that resolved over 80 tickets monthly. Attracted attention to Freshworks' OSS story via Hacktoberfest, resulting in 25 contributors in 2019 and 64 in 2020.</li>
            <li>Produced comprehensive migration guides supporting the transition of the top 15 Freshsales Classic apps to Freshsales Suite.</li>
            <li>Led partnership with product marketing to design the global Refresh App Challenge, resulting in a 29% conversion rate from 340 registrants and 100 team formations.</li>
          </ul>
        </div>

        <div class="space-y-2">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-semibold text-black dark:text-white">Student Experience Intern</h3>
            <span class="text-sm text-stone-500 dark:text-stone-400">Sep 2018 – Dec 2018</span>
          </div>
          <div class="text-sm text-stone-500 dark:text-stone-400">Udacity · New Delhi</div>
          <ul class="text-sm text-stone-700 dark:text-stone-300 space-y-1.5 mt-2">
            <li>Led the Google India Scholars Community program for 1000+ students, achieving a 50% graduation rate through scalable event strategies and data metrics.</li>
            <li>Championed the implementation of a scalable mentorship initiative, pairing students with industry professionals.</li>
          </ul>
        </div>
      </section>

      <!-- Involvement -->
      <section class="space-y-8">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-stone-400 dark:text-stone-500">Involvement</h2>

        <div class="space-y-2">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-semibold text-black dark:text-white">Creator of Hacksmith CLI</h3>
            <span class="text-sm text-stone-500 dark:text-stone-400">Sep 2025 – Nov 2025</span>
          </div>
          <div class="text-sm text-stone-500 dark:text-stone-400">Scalekit</div>
          <ul class="text-sm text-stone-700 dark:text-stone-300 space-y-1.5 mt-2">
            <li>Accelerated engineering productivity by automating complex setup and integration tasks through guided workflows called blueprints.</li>
            <li>Evolved the blueprint concept into plugins for major coding agents (Claude Code, Cursor, Copilot CLIs).</li>
            <li>Published Hacksmith as an open-source npm package, garnering community adoption and earning recognition among winners of the You.com Agentic Hackathon 2025.</li>
          </ul>
        </div>

        <div class="space-y-2">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-semibold text-black dark:text-white">Lead, Google Developer Student Clubs</h3>
            <span class="text-sm text-stone-500 dark:text-stone-400">Aug 2017 – Dec 2018</span>
          </div>
          <div class="text-sm text-stone-500 dark:text-stone-400">Sathyabama University · Chennai</div>
          <ul class="text-sm text-stone-700 dark:text-stone-300 space-y-1.5 mt-2">
            <li>Trained over 550 students to start with Android Studio and build essential apps through workshops. Enabled our college to be selected as one of 185 clubs from over 2000 student clubs.</li>
          </ul>
        </div>

        <div class="space-y-2">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-semibold text-black dark:text-white">Student Partner</h3>
            <span class="text-sm text-stone-500 dark:text-stone-400">Aug 2017 – Dec 2018</span>
          </div>
          <div class="text-sm text-stone-500 dark:text-stone-400">Microsoft</div>
          <ul class="text-sm text-stone-700 dark:text-stone-300 space-y-1.5 mt-2">
            <li>Developed session materials and coordinated campus workshops focused on emerging software platforms.</li>
          </ul>
        </div>

        <div class="space-y-2">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-semibold text-black dark:text-white">Dell Campassador</h3>
            <span class="text-sm text-stone-500 dark:text-stone-400">Oct 2017 – Jun 2018</span>
          </div>
          <div class="text-sm text-stone-500 dark:text-stone-400">Dell</div>
          <ul class="text-sm text-stone-700 dark:text-stone-300 space-y-1.5 mt-2">
            <li>Ranked all India Top #4 across all competing colleges in Dell Campus Ambassador program.</li>
          </ul>
        </div>
      </section>

      <!-- Education -->
      <section class="space-y-4">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-stone-400 dark:text-stone-500">Education</h2>
        <div>
          <h3 class="font-semibold text-black dark:text-white">Bachelor's in Computer Science</h3>
          <div class="text-sm text-stone-500 dark:text-stone-400">Sathyabama Institute of Science & Technology, Chennai · 2019</div>
        </div>
      </section>

      <!-- Skills -->
      <section class="space-y-4">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-stone-400 dark:text-stone-500">Skills</h2>
        <div class="flex flex-wrap gap-2">
          {["JavaScript", "Node.js", "TypeScript", "Python", "Building CLIs", "Astro", "Auth & SSO", "API Documentation", "Claude Code Plugins", "Developer Tools", "Git", "Bun", "Yarn", "PostHog"].map((skill) => (
            <span class="text-sm rounded-full bg-black/5 dark:bg-white/10 px-3 py-1 text-stone-700 dark:text-stone-300">{skill}</span>
          ))}
        </div>
      </section>

    </div>
  </Container>
</Base>

<style>
  @media print {
    header, footer, nav { display: none !important; }
    .animate { opacity: 1 !important; transform: none !important; animation: none !important; }
  }
</style>