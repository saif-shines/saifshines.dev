---
import Base from "@layouts/Base.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { getCollection } from "astro:content";
import {
  HOME,
  ROLE,
  ROLE_FOCUS,
  ROLE_WRITING,
  ROLE_WRITING_ORG,
  ROLE_WRITING_URL,
  ROLE_WRITING_LOGO,
} from "@consts";
import { formatDate } from "@lib/utils";

const thoughts = (await getCollection("thoughts"))
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
  .slice(0, 5);

const projects = (await getCollection("projects"))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const work = (await getCollection("work"))
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
  .slice(0, 4);

const claims = [
  {
    lead: "I put DX on fly mode",
    body: "context engineering so repos and support signal become docs issues, shared eng skills, and continuous polish on quickstarts, UX copy, and onboarding",
  },
  {
    lead: "I teach agents",
    body: "external skills for AI coding tools plus an internal skills repo shared across engineering",
  },
  {
    lead: "I grow ecosystems",
    body: "by getting Scalekit listed in other platforms' official docs and integrations",
  },
  {
    lead: "I remove friction",
    body: "with CLIs, docs architecture, and journeys that take developers from zero to production",
  },
];
---

<Base title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <!-- Letter open -->
    <section class="max-w-measure space-y-6 pb-10 pt-12">
      <p class="text-sm text-muted">
        {ROLE} · Bengaluru · {new Date().getFullYear()}
      </p>
      <h1 class="font-display text-[length:var(--text-display)] font-semibold leading-[1.15] tracking-tight text-ink">
        Hello, I'm Saif Ali Shaik.
      </h1>
      <p class="text-sm text-ink-2">
        {ROLE_FOCUS}
      </p>
      <p class="leading-relaxed text-ink-2">
        I care about the end-to-end developer experience: the systems, docs, and
        tooling that make adoption feel effortless. I engineer context so DX
        runs as a flywheel, ship CLIs, write friction logs, and polish the
        journeys developers actually take. Currently at
        <a
          href="https://scalekit.com"
          target="_blank"
          rel="noopener noreferrer"
          class="text-ink underline decoration-rule underline-offset-2 transition-[text-decoration-color] duration-short ease-hall hover:decoration-accent"
        >Scalekit</a>,
        previously at Freshworks. Both as the founding DevRel hire.
        In free time I write as an{" "}
        <a
          href={ROLE_WRITING_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="text-ink underline decoration-rule underline-offset-2 transition-[text-decoration-color] duration-short ease-hall hover:decoration-accent"
        >{ROLE_WRITING.toLowerCase()} for {ROLE_WRITING_ORG}</a>.
      </p>
      <p class="flex flex-wrap items-center gap-2 text-sm text-muted">
        <img
          src={ROLE_WRITING_LOGO}
          alt=""
          width="16"
          height="16"
          class="size-4 shrink-0 dark:invert"
        />
        <span>
          {ROLE_WRITING} ·{" "}
          <a
            href={ROLE_WRITING_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="text-ink-2 underline decoration-rule underline-offset-2 hover:decoration-accent"
          >{ROLE_WRITING_ORG}.org</a>
          {" "}· free time · current
        </span>
      </p>
      <nav class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm" aria-label="Social links">
        <a href="https://github.com/Saif-Shines" target="_blank" rel="noopener noreferrer" class="text-muted transition-colors duration-short ease-hall hover:text-ink">GitHub</a>
        <span class="text-rule" aria-hidden="true">·</span>
        <a href="https://linkedin.com/in/saif-shines" target="_blank" rel="noopener noreferrer" class="text-muted transition-colors duration-short ease-hall hover:text-ink">LinkedIn</a>
        <span class="text-rule" aria-hidden="true">·</span>
        <a href="https://world.hey.com/saif.shines" target="_blank" rel="noopener noreferrer" class="text-muted transition-colors duration-short ease-hall hover:text-ink">HEY World</a>
        <span class="text-rule" aria-hidden="true">·</span>
        <a href="https://sublime.app/saif_shines" target="_blank" rel="noopener noreferrer" class="text-muted transition-colors duration-short ease-hall hover:text-ink">Sublime</a>
        <span class="text-rule" aria-hidden="true">·</span>
        <a href={ROLE_WRITING_URL} target="_blank" rel="noopener noreferrer" class="text-muted transition-colors duration-short ease-hall hover:text-ink">freeCodeCamp</a>
        <span class="text-rule" aria-hidden="true">·</span>
        <a href="/resume" class="text-muted transition-colors duration-short ease-hall hover:text-ink">Resume</a>
      </nav>
    </section>

    <!-- Claims: lead + three, not equal 2×2 -->
    <section class="pb-12" aria-label="Focus areas">
      <div class="grid gap-8 sm:grid-cols-12">
        <div class="sm:col-span-5 space-y-1">
          <p class="font-display text-2xl font-semibold tracking-tight text-ink">
            {claims[0].lead}
          </p>
          <p class="text-sm leading-snug text-muted">
            {claims[0].body}
          </p>
        </div>
        <ul class="sm:col-span-7 space-y-5 border-t border-rule pt-5 sm:border-l sm:border-t-0 sm:pl-8 sm:pt-0">
          {claims.slice(1).map((c) => (
            <li class="space-y-0.5">
              <p class="font-display text-lg font-semibold text-ink">{c.lead}</p>
              <p class="text-sm leading-snug text-muted">{c.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <hr class="page-rule" aria-hidden="true" />

    <!-- Work — densest list -->
    <section class="space-y-4 py-10">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="font-display text-lg font-semibold text-ink">Work</h2>
        <Link href="/work" class="text-sm">See all</Link>
      </div>
      <ul class="not-prose divide-y divide-rule">
        {work.map((item) => (
          <li>
            <a
              href={item.data.url ?? "/work"}
              target={item.data.url ? "_blank" : undefined}
              rel={item.data.url ? "noopener noreferrer" : undefined}
              class="group flex items-start gap-3 py-3"
            >
              <span class="type-chip mt-0.5 shrink-0">
                {item.data.type}
              </span>
              <div class="min-w-0 flex-1">
                <div class="truncate font-medium text-ink group-hover:underline group-hover:decoration-accent group-hover:underline-offset-2">
                  {item.data.title}
                </div>
                <div class="mt-0.5 line-clamp-1 text-xs text-muted">
                  {item.data.description}
                </div>
              </div>
              <span class="mt-0.5 shrink-0 text-xs tabular-nums text-muted">
                {formatDate(item.data.date)}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <hr class="page-rule" aria-hidden="true" />

    <!-- Thoughts — quiet reading list -->
    <section class="space-y-3 py-10">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="font-display text-lg font-semibold text-ink">Thoughts</h2>
        <Link href="/thoughts" class="text-sm">See all</Link>
      </div>
      <ul class="not-prose">
        {thoughts.map((thought) => (
          <li>
            <a
              href={`/thoughts/${thought.id}`}
              class="group flex items-baseline justify-between gap-4 py-2"
            >
              <span class="truncate text-sm text-ink group-hover:underline group-hover:decoration-accent group-hover:underline-offset-2">
                {thought.data.title}
              </span>
              <span class="shrink-0 text-xs tabular-nums text-muted">
                {formatDate(thought.data.date)}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <hr class="page-rule" aria-hidden="true" />

    <!-- Projects — compact list, no bordered card grid -->
    <section class="space-y-4 py-10 pb-4">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="font-display text-lg font-semibold text-ink">Projects</h2>
        <Link href="/projects" class="text-sm">See all</Link>
      </div>
      <ul class="not-prose divide-y divide-rule">
        {projects.map((project) => (
          <li>
            <a
              href={project.data.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4"
            >
              <div class="min-w-0 flex flex-wrap items-baseline gap-x-2 gap-y-1">
                <span class="font-medium text-ink group-hover:underline group-hover:decoration-accent group-hover:underline-offset-2">
                  {project.data.name}
                </span>
                {project.data.language && (
                  <span class="text-[10px] font-medium uppercase tracking-wider text-muted">
                    {project.data.language}
                  </span>
                )}
                {project.data.status && (
                  <span class="status-chip">{project.data.status}</span>
                )}
              </div>
              <p class="line-clamp-2 text-xs text-muted sm:max-w-xs sm:text-right">
                {project.data.description}
              </p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </Container>
</Base>
